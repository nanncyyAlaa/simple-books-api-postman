		{
			"name": "Get Single Book",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// 1) Check the response status code is 200",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// 2) Extract book id from URL path and assert it matches the id in JSON response",
							"pm.test(\"Book id in URL matches id in response\", function () {",
							"    const urlPath = pm.request.url.getPath();",
							"    const urlIdMatch = urlPath.match(/\\/books\\/(\\d+)/);",
							"    pm.expect(urlIdMatch, \"URL should contain /books/{id} pattern\").to.not.be.null;",
							"    ",
							"    const urlId = parseInt(urlIdMatch[1], 10);",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.id).to.eql(urlId);",
							"});",
							"",
							"// 3) Assert that the response body is valid JSON",
							"pm.test(\"Response body is valid JSON\", function () {",
							"    pm.response.to.be.json;",
							"});",
							"",
							"// 4) Assert JSON response has required properties with appropriate types",
							"pm.test(\"Response has required properties with correct types\", function () {",
							"    const jsonData = pm.response.json();",
							"    ",
							"    // Check that response is an object",
							"    pm.expect(jsonData).to.be.an('object');",
							"    ",
							"    // Check required properties exist",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('name');",
							"    pm.expect(jsonData).to.have.property('author');",
							"    pm.expect(jsonData).to.have.property('type');",
							"    pm.expect(jsonData).to.have.property('price');",
							"    ",
							"    // Check types of required properties",
							"    pm.expect(jsonData.id).to.be.a('number');",
							"    pm.expect(jsonData.name).to.be.a('string');",
							"    pm.expect(jsonData.author).to.be.a('string');",
							"    pm.expect(jsonData.type).to.be.a('string');",
							"    pm.expect(jsonData.price).to.be.a('number');",
							"});",
							"",
							"// 5) Assert Content-Type header indicates JSON",
							"pm.test(\"Content-Type header indicates JSON\", function () {",
							"    pm.response.to.have.header(\"Content-Type\");",
							"    const contentType = pm.response.headers.get(\"Content-Type\");",
							"    pm.expect(contentType).to.include(\"application/json\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/books/5",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"books",
						"5"
					]
				}
			},
			"response": []
