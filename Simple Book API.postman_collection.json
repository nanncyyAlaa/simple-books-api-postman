		{
			"name": "Get List of Books",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test 1: Assert status code is 200\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Test 2: Assert response body is valid JSON\r",
							"pm.test(\"Response body is valid JSON\", function () {\r",
							"    pm.response.to.be.json;\r",
							"});\r",
							"\r",
							"// Test 3: Assert JSON is an array\r",
							"pm.test(\"Response is an array\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData).to.be.an('array');\r",
							"});\r",
							"\r",
							"// Test 4: Assert each book has required properties with correct types\r",
							"pm.test(\"Each book has required properties with correct types\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    \r",
							"    jsonData.forEach((book, index) => {\r",
							"        pm.expect(book).to.have.property('id');\r",
							"        pm.expect(book.id).to.be.a('number', `Book at index ${index} should have 'id' as a number`);\r",
							"        \r",
							"        pm.expect(book).to.have.property('name');\r",
							"        pm.expect(book.name).to.be.a('string', `Book at index ${index} should have 'name' as a string`);\r",
							"        \r",
							"        pm.expect(book).to.have.property('type');\r",
							"        pm.expect(book.type).to.be.a('string', `Book at index ${index} should have 'type' as a string`);\r",
							"        \r",
							"        pm.expect(book).to.have.property('available');\r",
							"        pm.expect(book.available).to.be.a('boolean', `Book at index ${index} should have 'available' as a boolean`);\r",
							"    });\r",
							"});\r",
							"\r",
							"// Test 5: Assert each book has a valid type value (fiction or non-fiction)\r",
							"pm.test(\"Each book has a valid type value (fiction or non-fiction)\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    \r",
							"    jsonData.forEach((book, index) => {\r",
							"        pm.expect(book.type).to.be.oneOf(['fiction', 'non-fiction'], `Book at index ${index} should have 'type' as either 'fiction' or 'non-fiction'`);\r",
							"    });\r",
							"});\r",
							"\r",
							"// Test 6: Assert number of books returned does not exceed the limit query parameter\r",
							"pm.test(\"Number of books does not exceed the limit query parameter\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    const limitParam = pm.request.url.query.get('limit');\r",
							"    \r",
							"    if (limitParam) {\r",
							"        const limit = parseInt(limitParam, 10);\r",
							"        pm.expect(jsonData.length).to.be.at.most(limit, `Expected at most ${limit} books but got ${jsonData.length}`);\r",
							"    }\r",
							"});\r",
							"// Test: All books have the exact requested type\r",
							"pm.test(\"All books have the exact requested type\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"\r",
							"    // Read requested type from query params\r",
							"    const requestedType = pm.request.url.query.get('type');\r",
							"\r",
							"    jsonData.forEach((book, index) => {\r",
							"        pm.expect(book).to.have.property('type');\r",
							"        pm.expect(book.type, `Book at index ${index} should have type '${requestedType}'`)\r",
							"            .to.eql(requestedType);\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/books?type=fiction&limit=5",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"books"
					],
					"query": [
						{
							"key": "type",
							"value": "fiction"
						},
						{
							"key": "limit",
							"value": "5"
						}
					]
				}
			},
			"response": []
